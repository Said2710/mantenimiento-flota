<%
    String fleetNavPath = request.getRequestURI();
%>
<button class="fleet-menu-toggle" id="fleetMenuToggle" type="button" aria-controls="fleetSidebar" aria-expanded="false">
    <i class="bi bi-list" aria-hidden="true"></i>
    <span>Men&uacute;</span>
</button>
<div class="fleet-menu-backdrop" id="fleetMenuBackdrop" aria-hidden="true"></div>
<aside class="fleet-sidebar" id="fleetSidebar" aria-label="Navegación principal">
    <a class="fleet-sidebar-brand" href="UsuarioServlet">
        <img src="assets/img/fleetpro-mark.svg" alt="">
        <span>
            <strong class="d-block">FleetPro</strong>
            <small class="text-white-50">Control &amp; Mantenimiento</small>
        </span>
    </a>
    <nav class="fleet-sidebar-nav" aria-label="M&oacute;dulos">
        <div class="fleet-sidebar-label">Gesti&oacute;n de flota</div>
        <a class="fleet-nav-link <%= fleetNavPath.endsWith("UsuarioServlet") ? "active" : "" %>" href="UsuarioServlet"><i class="bi bi-people-fill" aria-hidden="true"></i><span>Usuarios</span></a>
        <a class="fleet-nav-link <%= fleetNavPath.endsWith("ClienteServlet") ? "active" : "" %>" href="ClienteServlet"><i class="bi bi-person-vcard" aria-hidden="true"></i><span>Clientes</span></a>
        <a class="fleet-nav-link <%= fleetNavPath.endsWith("ProveedorServlet") ? "active" : "" %>" href="ProveedorServlet"><i class="bi bi-building" aria-hidden="true"></i><span>Proveedores</span></a>
        <a class="fleet-nav-link <%= fleetNavPath.endsWith("RepuestoServlet") ? "active" : "" %>" href="RepuestoServlet"><i class="bi bi-box-seam" aria-hidden="true"></i><span>Repuestos</span></a>
        <a class="fleet-nav-link <%= fleetNavPath.endsWith("VehiculoServlet") ? "active" : "" %>" href="VehiculoServlet"><i class="bi bi-truck-front" aria-hidden="true"></i><span>Veh&iacute;culos</span></a>
        <a class="fleet-nav-link <%= fleetNavPath.endsWith("ComponenteServlet") ? "active" : "" %>" href="ComponenteServlet"><i class="bi bi-gear-wide-connected" aria-hidden="true"></i><span>Componentes</span></a>
        <div class="fleet-sidebar-label mt-2">Mantenimiento</div>
        <a class="fleet-nav-link <%= fleetNavPath.endsWith("ReglaMantenimientoServlet") ? "active" : "" %>" href="ReglaMantenimientoServlet"><i class="bi bi-tools" aria-hidden="true"></i><span>Reglas de mantenimiento</span></a>
        <a class="fleet-nav-link <%= fleetNavPath.endsWith("RegistroOperacionServlet") ? "active" : "" %>" href="RegistroOperacionServlet"><i class="bi bi-speedometer2" aria-hidden="true"></i><span>Lecturas de operaci&oacute;n</span></a>
        <a class="fleet-nav-link <%= fleetNavPath.endsWith("EvaluacionMantenimientoServlet") ? "active" : "" %>" href="EvaluacionMantenimientoServlet"><i class="bi bi-clipboard2-pulse" aria-hidden="true"></i><span>Evaluaci&oacute;n preventiva</span></a>
        <a class="fleet-nav-link <%= fleetNavPath.endsWith("SolicitudServicioServlet") ? "active" : "" %>" href="SolicitudServicioServlet"><i class="bi bi-file-earmark-plus" aria-hidden="true"></i><span>Solicitudes de servicio</span></a>
        <a class="fleet-nav-link <%= fleetNavPath.endsWith("VentaServicioServlet") ? "active" : "" %>" href="VentaServicioServlet"><i class="bi bi-receipt" aria-hidden="true"></i><span>Ventas de servicio</span></a>
    </nav>
    <div class="fleet-sidebar-footer">
        <a class="fleet-logout-link" href="LogoutServlet"><i class="bi bi-box-arrow-left" aria-hidden="true"></i><span>Cerrar sesi&oacute;n</span></a>
    </div>
</aside>
<script>
    (function () {
        var toggle = document.getElementById('fleetMenuToggle');
        var backdrop = document.getElementById('fleetMenuBackdrop');
        var links = document.querySelectorAll('.fleet-nav-link, .fleet-logout-link, .fleet-sidebar-brand');
        function setMenu(open) {
            document.body.classList.toggle('fleet-menu-open', open);
            toggle.setAttribute('aria-expanded', String(open));
        }
        toggle.addEventListener('click', function () {
            setMenu(!document.body.classList.contains('fleet-menu-open'));
        });
        backdrop.addEventListener('click', function () { setMenu(false); });
        links.forEach(function (link) {
            link.addEventListener('click', function () { setMenu(false); });
        });
        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') setMenu(false);
        });
    })();
</script>
